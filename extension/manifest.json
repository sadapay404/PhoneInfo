{
  "manifest_version": 3,
  "name": "AetherPhone Saver",
  "version": "0.6.1",
  "description": "Save GSMArena phones, photos and 3D viewer images, and log PKR prices from PriceOye, to your own AetherPhone library. Personal use.",
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://www.gsmarena.com/*",
    "https://fdn.gsmarena.com/*",
    "https://fdn2.gsmarena.com/*",
    "https://images.priceoye.pk/*",
    "https://engage-content.binkies3d.com/*",
    "https://engage-content2.binkies3d.com/*",
    "https://render.binkies3d.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.gsmarena.com/*"
      ],
      "js": [
        "extract.js",
        "mapper.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.gsmarena.com/*",
        "https://*.binkies3d.com/*"
      ],
      "js": [
        "binkies-core.js",
        "binkies.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://priceoye.pk/*"
      ],
      "js": [
        "prices-core.js",
        "priceoye-core.js",
        "priceoye-extract.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "AetherPhone Saver",
    "default_popup": "popup.html"
  }
}
