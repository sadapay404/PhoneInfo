{
  "manifest_version": 3,
  "name": "AetherPhone Saver",
  "version": "0.2.0",
  "description": "Save a GSMArena phone page and its photos to your own AetherPhone library, for personal offline use.",
  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": [
    "https://www.gsmarena.com/*",
    "https://fdn.gsmarena.com/*",
    "https://fdn2.gsmarena.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.gsmarena.com/*"],
      "js": ["extract.js", "mapper.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "AetherPhone Saver",
    "default_popup": "popup.html"
  }
}
