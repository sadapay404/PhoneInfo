{
  "name": "phoneinfo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/fetch-model.mjs && node scripts/copy-ort.mjs",
    "dev": "npm run catalog:build && vite --host 0.0.0.0 --port 3000 --strictPort",
    "catalog:build": "node scripts/build-catalog.mjs",
    "catalog:build:full": "CATALOG_SOURCE=data/export/devices.json node scripts/build-catalog.mjs",
    "prebuild": "node scripts/fetch-model.mjs && node scripts/copy-ort.mjs",
    "build": "npm run catalog:build && tsc --noEmit && vite build && rm -rf dist/catalog",
    "preview": "vite preview --host 0.0.0.0 --port 3000 --strictPort",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run catalog:build"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/app": "^6.0.3",
    "@capacitor/core": "^6.2.2",
    "dexie": "^4.4.7",
    "fuse.js": "^7.0.0",
    "jszip": "^3.10.2",
    "lz-string": "^1.5.0",
    "onnxruntime-web": "^1.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.2",
    "@types/lz-string": "^1.3.34",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
